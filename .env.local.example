# Magento GraphQL endpoint (required)
MAGENTO_GRAPHQL_URL=https://www1.tyresworld.ae/graphql
# Basic-auth credentials for the GraphQL endpoint (ask the backend team)
GRAPHQL_USERNAME=your_username
GRAPHQL_PASSWORD=your_password

NEXT_PUBLIC_SITE_URL=https://www.tyresworld.ae
NEXT_PUBLIC_API_URL=https://www.tyresworld.ae/api

# Wheel API (third-party tyre/wheel lookup). Required for the wheel finder.
WHEEL_API_URL=https://wheel-api.klever.ae/graphql.php
WHEEL_USER_KEY=your_wheel_api_key
