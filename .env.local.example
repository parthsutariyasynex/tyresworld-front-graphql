# Magento GraphQL endpoint (required)
MAGENTO_GRAPHQL_URL=https://powertire.klever.ae/graphql

# Optional: default category uid for the homepage "All" view
# (base64 of the Magento category id; "MTg=" = Tyres, "Mg==" = store root)
# MAGENTO_DEFAULT_CATEGORY_UID=MTg=

# Optional: Magento integration/admin bearer token.
# Enables server-side admin operations (lib/magento-admin.ts):
# attributesList (full set) and generateCustomerTokenAsAdmin.
# Leave unset to keep admin operations disabled.
# MAGENTO_ADMIN_TOKEN=
